// @version=6
// Jarvis Quick Scalp - VWAP Momentum Cross - MNQ ONLY
//
// Fixed point target/stop, single entry, auto-close - no scale-in, no
// partials, no ATR-based sizing. This is a fast in/out trade, not a
// managed multi-bar position like the other three strategies in this
// repo (meanrev, orb, vwap_pullback all scale in/out against ATR).
//
// Entry: a FRESH VWAP cross (crossing THIS bar, not an extended one)
// confirmed by fast EMA momentum in the same direction and a volume
// spike. Exit: fixed point target or fixed point stop, whichever hits
// first.
//
// backtest_optimizer.py's "scalp" family walk-forward result (MNQ 5m,
// June 2 - Aug 12 window): target=12pts, stop 4-6pts (tested insensitive
// across that range), EMA length 9, volume 1.2x -> OUT-OF-SAMPLE PF
// 1.449, 48 trades, $796 net, $849 max drawdown at 2 contracts - well
// inside the account's $1,300 safety budget / $2,000 real trailing
// drawdown limit. Unlike vwap_pullback, this one did NOT need a sizing
// rescue to fit the account - see repo README for the full comparison.
//
// STILL NOT VALIDATED against real TradingView data - that's the next
// step, same process used for every other strategy here. Also: only one
// ~10-week window has been tested so far (Yahoo's 60-day cap on 5-minute
// data plus the in-sample/out-of-sample split limits how far back
// backtest_optimizer.py can pull in a single run) - a hold-up on one
// window is promising, not proof. See README for how to get a longer
// read without paying for TradingView Premium's Deep Backtesting.
//
// This strategy is meant to be run on a TradingView chart (load MNQ1!
// continuous futures), with its order-fill alerts wired to PickMyTrade
// (or a similar bridge) to execute on your Tradeify account.
//
// Do NOT hand-write the webhook JSON yourself — use PickMyTrade's own
// alert JSON generator in their dashboard and paste that into the
// TradingView alert message box. See README for the full setup steps.

strategy("Jarvis Quick Scalp - VWAP Momentum Cross - MNQ",
     overlay = true,
     default_qty_type = strategy.fixed,
     default_qty_value = 2,
     pyramiding = 0,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 1,
     slippage = 2)

// ---------------------------------------------------------------------
// Inputs — defaults match the walk-forward-tested MNQ 5m config
// ---------------------------------------------------------------------
targetPoints = input.float(12.0, "Target (points)")
stopPoints   = input.float(6.0, "Stop (points) - tested insensitive across 4-6")

emaLen  = input.int(9, "Fast EMA Length")
volLen  = input.int(20, "Volume Avg Length")
volMult = input.float(1.2, "Volume Multiplier")

size = input.int(2, "Size (contracts) - fixed, no scale-in on a scalp")

sessionStartHour = input.int(9, "Session Start Hour (ET)")
sessionStartMin  = input.int(30, "Session Start Minute (ET)")
sessionEndHour   = input.int(16, "Session End Hour (ET)")
sessionEndMin    = input.int(0, "Session End Minute (ET)")

dailyKillUSD = input.float(900, "Daily Kill Switch ($) - placeholder, confirm real Tradeify drawdown figure")

// ---------------------------------------------------------------------
// Session helpers (ET) - plain minute-of-day arithmetic
// ---------------------------------------------------------------------
etHour   = hour(time, "America/New_York")
etMinute = minute(time, "America/New_York")
etDay    = dayofmonth(time, "America/New_York")

nowMinutes          = etHour * 60 + etMinute
sessionStartMinutes = sessionStartHour * 60 + sessionStartMin
sessionEndMinutes   = sessionEndHour * 60 + sessionEndMin
inSession = nowMinutes >= sessionStartMinutes and nowMinutes <= sessionEndMinutes

newDay = ta.change(etDay) != 0

// ---------------------------------------------------------------------
// Indicators
// ---------------------------------------------------------------------
avgVol = ta.sma(volume, volLen)
volConfirmed = volume > (avgVol * volMult)

vwapValue = ta.vwap(hlc3)
fastEma = ta.ema(close, emaLen)

plot(vwapValue, "VWAP", color = color.yellow, linewidth = 2)
plot(fastEma, "Fast EMA", color = color.aqua)

// ---------------------------------------------------------------------
// Daily kill switch
// ---------------------------------------------------------------------
var float dayStartEquity = na
var bool  dailyHalted = false

if newDay
    dayStartEquity := strategy.equity
    dailyHalted := false

dailyPnl = na(dayStartEquity) ? 0.0 : strategy.equity - dayStartEquity

if dailyPnl <= -dailyKillUSD and not dailyHalted
    strategy.close_all(comment = "DAILY KILL SWITCH")
    dailyHalted := true

canTrade = inSession and not dailyHalted

// ---------------------------------------------------------------------
// Per-position state (reset whenever flat)
// ---------------------------------------------------------------------
var float targetPrice = na
var float stopPrice = na

if strategy.position_size == 0
    targetPrice := na
    stopPrice := na

// ---------------------------------------------------------------------
// Entry: fresh VWAP cross (this bar), confirmed by EMA momentum + volume
// ---------------------------------------------------------------------
freshCrossUp   = close[1] <= vwapValue[1] and close > vwapValue and close > fastEma
freshCrossDown = close[1] >= vwapValue[1] and close < vwapValue and close < fastEma

if strategy.position_size == 0 and canTrade
    if freshCrossUp and volConfirmed
        strategy.entry("Long", strategy.long, qty = size, comment = "SCALP LONG")
        targetPrice := close + targetPoints
        stopPrice := close - stopPoints
    else if freshCrossDown and volConfirmed
        strategy.entry("Short", strategy.short, qty = size, comment = "SCALP SHORT")
        targetPrice := close - targetPoints
        stopPrice := close + stopPoints

// ---------------------------------------------------------------------
// Exit: fixed point target or stop, whichever hits first (always active,
// regardless of session, for safety)
// ---------------------------------------------------------------------
if strategy.position_size > 0
    if close >= targetPrice
        strategy.close("Long", comment = "TARGET")
    else if close <= stopPrice
        strategy.close("Long", comment = "STOP")

if strategy.position_size < 0
    if close <= targetPrice
        strategy.close("Short", comment = "TARGET")
    else if close >= stopPrice
        strategy.close("Short", comment = "STOP")

// ---------------------------------------------------------------------
// On-chart status table
// ---------------------------------------------------------------------
var table statusTable = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    table.cell(statusTable, 0, 0, "Daily P&L", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 0, str.tostring(dailyPnl, "#.##"), bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 1, "Kill Switch", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 1, dailyHalted ? "HALTED" : "Active",
         bgcolor = color.gray, text_color = dailyHalted ? color.red : color.green)
    table.cell(statusTable, 0, 2, "Position", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 2, str.tostring(strategy.position_size), bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 3, "In Session", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 3, inSession ? "Yes" : "No", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 4, "Target", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 4, na(targetPrice) ? "—" : str.tostring(targetPrice, "#.##"),
         bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 5, "Stop", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 5, na(stopPrice) ? "—" : str.tostring(stopPrice, "#.##"),
         bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 6, "Volume", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 6, volConfirmed ? "Confirmed" : "—",
         bgcolor = color.gray, text_color = color.white)
