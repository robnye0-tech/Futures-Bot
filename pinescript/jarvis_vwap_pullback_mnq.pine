// @version=6
// Jarvis VWAP Pullback Trend-Continuation Strategy — MNQ ONLY
//
// Opposite mechanism from jarvis_meanrev_vwap_scaler.pine: trades WITH a
// moderately trending market (ADX in a band, e.g. 20-30 or 20-40 - NOT
// the low-ADX range-bound condition mean-reversion wants) instead of
// fading extremes. Waits for price to pull back TO VWAP and get
// rejected (a candle that dips to/through VWAP but closes back on the
// trend side), then enters on a breakout of that rejection candle's
// high/low.
//
// MNQ-only by design: walk-forward testing (backtest_optimizer.py)
// found real signal on MNQ (both 5m and 15m) but MES results were weak
// and inconsistent - consistent with the earlier mean-reversion finding
// that MES doesn't hold up the way MNQ does. Don't run this on MES.
//
// Two candidate configs found in walk-forward testing:
//   5-minute:  ADX 15-30, trend EMA 10/50,  stop 1.5x ATR
//   15-minute: ADX 20-40, trend EMA 10/100, stop 2.0x ATR
//
// REAL TradingView RESULTS (June 18 - Aug 12 window, original 3/3/9
// contract sizing): PF 1.527, 52 trades, $4,928 net - BUT $3,570 max
// drawdown against the account's real $2,000 EOD trailing drawdown
// limit. Not tradeable at that size. Tightening the stop to allow more
// size was tried and confirmed to NOT work (0.5x ATR broke the edge,
// OOS PF 0.000) - the fix is reduced size at the original 1.5x ATR
// stop.
//
// SIZING: RESOLVED FOR REAL, confirmed in TradingView (not just Python).
// The scale-in mechanic was the problem, not the base entries. At
// base=1/max=3, scaling in reset the stop to a tighter `close - atrVal`
// (fresh 1x ATR from the current price, not the original 1.5x-ATR entry
// stop) at the same moment the position got bigger, so a normal
// pullback (not a real reversal) could stop out the whole enlarged
// position - real result there was PF 0.509, net -$2,652.50, a loser,
// even though the base entries alone were profitable (+$1,026 net) in
// that same test's signal breakdown.
//
// FIX: disable scale-in entirely - base=1, addSize=0, maxSize=1 (the
// defaults below). CONFIRMED CLEAN in TradingView: PF 1.825, 19 trades,
// 68.42% win rate, $934.50 net, $443.50 max drawdown (well under both
// the $1,300 safety budget and the $2,000 hard limit). Outliers PnL was
// NEGATIVE (-$339.50) - the opposite of an outlier-propped-up result;
// the ordinary trades did the real work, which is the specific check
// that killed a different candidate earlier in this project. Sample
// size (19 trades) is still modest - the paper trading week is what
// builds real confidence beyond this one confirmation.
//
//   15-minute: PF ~1.05 with the corrected inputs above - no real edge.
//              Kept wired into the auto-timeframe switch below for
//              reference only; entries are DISABLED on 15m charts.
//
// Auto-timeframe switching (input "Auto-Adjust Parameters By Chart
// Timeframe", default on): the script detects timeframe.period and
// switches ADX band / trend EMA lengths / stop multiple automatically -
// you should be able to drop this on a 1m, 5m, or 15m MNQ chart without
// touching inputs. IMPORTANT: this does NOT mean every timeframe is safe
// to trade - only 5-minute has a real confirmed edge as of this build.
// 15-minute and any other timeframe (including 1-minute, not yet tested
// at all) have entries disabled via the tfValidated gate; the on-chart
// status table's "Timeframe" row shows which state you're in. Turn the
// auto-adjust input off to force the manual inputs on any timeframe.
//
// Ready for the paper trading week at the base=1/addSize=0/max=1
// defaults below. Still not ready for a funded account until that week
// (or several) comes back clean too - one 19-trade confirmation is
// real, not proof by itself.
//
// For the current paper-trading test: load on an MNQ1! chart and
// connect it to TradingView's own built-in Paper Trading broker (via
// the Trading Panel) - no PickMyTrade needed for this, since nothing
// here should touch real money yet.
//
// If/when this later moves to a real funded account: order-fill alerts
// get wired to PickMyTrade (or a similar bridge) to execute on Tradeify.
// Do NOT hand-write that webhook JSON yourself — use PickMyTrade's own
// alert JSON generator in their dashboard. See README for setup steps.

strategy("Jarvis VWAP Pullback Trend-Continuation - MNQ",
     overlay = true,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     pyramiding = 10,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 1,
     slippage = 2)

// ---------------------------------------------------------------------
// Inputs — defaults match the walk-forward-tested 5-minute config
// ---------------------------------------------------------------------
adxLen  = input.int(14, "ADX Length")
adxLow  = input.float(15, "ADX Low Bound (trending regime floor)")
adxHigh = input.float(30, "ADX High Bound (trending regime ceiling)")

trendFastLen = input.int(10, "Trend Fast EMA Length")
trendSlowLen = input.int(50, "Trend Slow EMA Length")

breakoutWindow = input.int(5, "Breakout Window (bars to wait after rejection candle)")

atrLen  = input.int(14, "ATR Length")
volLen  = input.int(20, "Volume Avg Length")
volMult = input.float(1.5, "Volume Multiplier")

baseSize = input.int(1, "Base Size (contracts)")
addSize  = input.int(0, "Scale-In Add Size - 0 disables scale-in (confirmed default, see header)")
maxSize  = input.int(1, "Max Position Size (contracts) - 1 disables scale-in (confirmed default, see header)")

stopAtrMult    = input.float(1.5, "Stop ATR Multiple (beyond entry)")
scaleInAtrMult = input.float(1.0, "Scale-In ATR Multiple")
target1AtrMult = input.float(1.0, "Target 1 ATR Multiple")
target2AtrMult = input.float(2.0, "Target 2 ATR Multiple")

sessionStartHour = input.int(9, "Session Start Hour (ET)")
sessionStartMin  = input.int(30, "Session Start Minute (ET)")
sessionEndHour   = input.int(16, "Session End Hour (ET)")
sessionEndMin    = input.int(0, "Session End Minute (ET)")

dailyKillUSD = input.float(900, "Daily Kill Switch ($) - placeholder, confirm real Tradeify drawdown figure")

autoAdjustByTimeframe = input.bool(true, "Auto-Adjust Parameters By Chart Timeframe",
     tooltip = "When on, ADX band / trend EMA lengths / stop multiple switch automatically based on the chart's timeframe using the configs found in walk-forward + TradingView testing, instead of the manual inputs above. Timeframes without a real confirmed edge (currently: everything except 5-minute) have entries DISABLED even in auto mode - see the 'Timeframe' status row (green = validated, orange = entries disabled). Turn this off to force the manual inputs above on any timeframe (you are then asserting those values yourself).")

// ---------------------------------------------------------------------
// Session helpers (ET) - plain minute-of-day arithmetic
// ---------------------------------------------------------------------
etHour   = hour(time, "America/New_York")
etMinute = minute(time, "America/New_York")
etDay    = dayofmonth(time, "America/New_York")

nowMinutes          = etHour * 60 + etMinute
sessionStartMinutes = sessionStartHour * 60 + sessionStartMin
sessionEndMinutes   = sessionEndHour * 60 + sessionEndMin
inSession = nowMinutes >= sessionStartMinutes and nowMinutes <= sessionEndMinutes

newDay = ta.change(etDay) != 0

// ---------------------------------------------------------------------
// Indicators
// ---------------------------------------------------------------------
atrVal = ta.atr(atrLen)
avgVol = ta.sma(volume, volLen)
volConfirmed = volume > (avgVol * volMult)

vwapValue = ta.vwap(hlc3)
[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)

// ---------------------------------------------------------------------
// Per-timeframe config switching. ta.ema requires a fixed (non-series)
// length, so every candidate EMA length is precomputed here as its own
// call, and the switch below only SELECTS among already-computed series -
// it never feeds a runtime-varying length into ta.ema itself.
//
// Only the 5-minute config has real TradingView-confirmed edge as of this
// build (PF 1.527, 52 trades - see repo README). 15-minute was tested
// with its own found config (ADX 20-40, EMA 10/100, stop 2.0x ATR) and
// came back PF ~1.05 on real data - no real edge, so it stays wired up
// here for reference but marked NOT validated. Any other timeframe (1m,
// etc.) has not been tested at all. tfValidated gates new entries so
// switching charts never silently trades an unconfirmed setup.
// ---------------------------------------------------------------------
ema10  = ta.ema(close, 10)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
emaFastManual = ta.ema(close, trendFastLen)
emaSlowManual = ta.ema(close, trendSlowLen)

float effAdxLow  = adxLow
float effAdxHigh = adxHigh
float effStopAtrMult = stopAtrMult
float trendFastEma = emaFastManual
float trendSlowEma = emaSlowManual
bool  tfValidated = true
string tfLabel = "Manual"

if autoAdjustByTimeframe
    if timeframe.period == "5"
        effAdxLow := 15.0
        effAdxHigh := 30.0
        effStopAtrMult := 1.5
        trendFastEma := ema10
        trendSlowEma := ema50
        tfValidated := true
        tfLabel := "5m (validated)"
    else if timeframe.period == "15"
        effAdxLow := 20.0
        effAdxHigh := 40.0
        effStopAtrMult := 2.0
        trendFastEma := ema10
        trendSlowEma := ema100
        tfValidated := false
        tfLabel := "15m (NOT validated - PF ~1.05 on real data)"
    else
        tfValidated := false
        tfLabel := timeframe.period + " (untested)"

regimeTrending = adxValue >= effAdxLow and adxValue <= effAdxHigh
uptrend   = trendFastEma > trendSlowEma
downtrend = trendFastEma < trendSlowEma

plot(vwapValue, "VWAP", color = color.yellow, linewidth = 2)
plot(trendFastEma, "Trend Fast EMA", color = color.aqua)
plot(trendSlowEma, "Trend Slow EMA", color = color.purple)

// ---------------------------------------------------------------------
// Daily kill switch
// ---------------------------------------------------------------------
var float dayStartEquity = na
var bool  dailyHalted = false

if newDay
    dayStartEquity := strategy.equity
    dailyHalted := false

dailyPnl = na(dayStartEquity) ? 0.0 : strategy.equity - dayStartEquity

if dailyPnl <= -dailyKillUSD and not dailyHalted
    strategy.close_all(comment = "DAILY KILL SWITCH")
    dailyHalted := true

canTrade = inSession and not dailyHalted and tfValidated

// ---------------------------------------------------------------------
// Per-position state (reset whenever flat)
// ---------------------------------------------------------------------
var float lastScalePrice = na
var float stopPrice = na
var bool  target1Hit = false
var bool  target2Hit = false

if strategy.position_size == 0
    lastScalePrice := na
    stopPrice := na
    target1Hit := false
    target2Hit := false

if strategy.position_size != 0 and na(lastScalePrice)
    lastScalePrice := strategy.position_avg_price
    stopPrice := strategy.position_size > 0 ?
         close - atrVal * effStopAtrMult : close + atrVal * effStopAtrMult

// ---------------------------------------------------------------------
// Pending setup tracking: a rejection candle sets a pending breakout
// level, a later bar breaking it triggers the actual entry. Only
// tracked while flat and in-session, matching the Python optimizer.
// ---------------------------------------------------------------------
var string pendingDirection = na
var float  pendingTrigger = na
var int    pendingBarsLeft = 0

if strategy.position_size == 0 and canTrade
    if pendingDirection == "long"
        if high >= pendingTrigger
            strategy.entry("Long", strategy.long, qty = baseSize, comment = "PULLBACK LONG")
            lastScalePrice := close
            stopPrice := close - atrVal * effStopAtrMult
            pendingDirection := na
        else
            pendingBarsLeft := pendingBarsLeft - 1
            if pendingBarsLeft <= 0
                pendingDirection := na
    else if pendingDirection == "short"
        if low <= pendingTrigger
            strategy.entry("Short", strategy.short, qty = baseSize, comment = "PULLBACK SHORT")
            lastScalePrice := close
            stopPrice := close + atrVal * effStopAtrMult
            pendingDirection := na
        else
            pendingBarsLeft := pendingBarsLeft - 1
            if pendingBarsLeft <= 0
                pendingDirection := na

    if na(pendingDirection)
        // Rejection candle: dipped to/through VWAP then closed back on the trend side
        if uptrend and regimeTrending and low <= vwapValue and close > vwapValue and close > open and volConfirmed
            pendingDirection := "long"
            pendingTrigger := high
            pendingBarsLeft := breakoutWindow
        else if downtrend and regimeTrending and high >= vwapValue and close < vwapValue and close < open and volConfirmed
            pendingDirection := "short"
            pendingTrigger := low
            pendingBarsLeft := breakoutWindow

// ---------------------------------------------------------------------
// Scale in — only on continued confirmed momentum, never into a loser
// ---------------------------------------------------------------------
longFavorable  = strategy.position_size > 0 ? close - lastScalePrice : na
shortFavorable = strategy.position_size < 0 ? lastScalePrice - close : na

canScaleInLong  = canTrade and strategy.position_size > 0 and strategy.position_size < maxSize and
     not na(longFavorable) and longFavorable >= atrVal * scaleInAtrMult and volConfirmed
canScaleInShort = canTrade and strategy.position_size < 0 and math.abs(strategy.position_size) < maxSize and
     not na(shortFavorable) and shortFavorable >= atrVal * scaleInAtrMult and volConfirmed

if canScaleInLong
    strategy.entry("Long", strategy.long, qty = addSize, comment = "SCALE IN")
    lastScalePrice := close
    stopPrice := close - atrVal

if canScaleInShort
    strategy.entry("Short", strategy.short, qty = addSize, comment = "SCALE IN")
    lastScalePrice := close
    stopPrice := close + atrVal

// ---------------------------------------------------------------------
// Stop loss (always active, regardless of session, for safety)
// ---------------------------------------------------------------------
if strategy.position_size > 0 and close <= stopPrice
    strategy.close("Long", comment = "STOP")

if strategy.position_size < 0 and close >= stopPrice
    strategy.close("Short", comment = "STOP")

// ---------------------------------------------------------------------
// Partial profit taking (always active, regardless of session)
// ---------------------------------------------------------------------
target1Long  = lastScalePrice + atrVal * target1AtrMult
target2Long  = lastScalePrice + atrVal * target2AtrMult
target1Short = lastScalePrice - atrVal * target1AtrMult
target2Short = lastScalePrice - atrVal * target2AtrMult

if strategy.position_size > 0 and not target2Hit and close >= target2Long
    strategy.close("Long", qty_percent = 33, comment = "SCALE OUT T2")
    target2Hit := true
    stopPrice := lastScalePrice
else if strategy.position_size > 0 and not target1Hit and close >= target1Long
    strategy.close("Long", qty_percent = 33, comment = "SCALE OUT T1")
    target1Hit := true

if strategy.position_size < 0 and not target2Hit and close <= target2Short
    strategy.close("Short", qty_percent = 33, comment = "SCALE OUT T2")
    target2Hit := true
    stopPrice := lastScalePrice
else if strategy.position_size < 0 and not target1Hit and close <= target1Short
    strategy.close("Short", qty_percent = 33, comment = "SCALE OUT T1")
    target1Hit := true

// ---------------------------------------------------------------------
// On-chart status table
// ---------------------------------------------------------------------
var table statusTable = table.new(position.top_right, 2, 9, border_width = 1)
if barstate.islast
    table.cell(statusTable, 0, 0, "Timeframe", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 0, tfLabel, bgcolor = color.gray, text_color = tfValidated ? color.green : color.orange)
    table.cell(statusTable, 0, 1, "Daily P&L", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 1, str.tostring(dailyPnl, "#.##"), bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 2, "Kill Switch", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 2, dailyHalted ? "HALTED" : "Active",
         bgcolor = color.gray, text_color = dailyHalted ? color.red : color.green)
    table.cell(statusTable, 0, 3, "Position", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 3, str.tostring(strategy.position_size), bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 4, "In Session", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 4, inSession ? "Yes" : "No", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 5, "ADX (regime)", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 5, str.tostring(adxValue, "#.##") + (regimeTrending ? " (In band)" : " (Out)"),
         bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 6, "Trend", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 6, uptrend ? "Up" : downtrend ? "Down" : "Flat",
         bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 7, "Pending Setup", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 7, na(pendingDirection) ? "—" : pendingDirection + " @ " + str.tostring(pendingTrigger, "#.##"),
         bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 8, "Stop Price", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 8, na(stopPrice) ? "—" : str.tostring(stopPrice, "#.##"),
         bgcolor = color.gray, text_color = color.white)
