// @version=6
// Jarvis ORB + VWAP + ADX Scale-In-Out Strategy — MNQ / MES
//
// Opening Range Breakout, confirmed by VWAP confluence, volume, and an
// ADX momentum/trend-strength filter. Replaces the EMA-crossover version
// (jarvis_mnq_mes_scaler.pine), which was tested via walk-forward
// validation and found to have no real out-of-sample edge — see repo
// README for that history.
//
// This strategy is meant to be run on a TradingView chart (load MNQ1! or
// MES1! continuous futures), with its order-fill alerts wired to
// PickMyTrade (or a similar bridge) to execute on your Tradeify account.
//
// Do NOT hand-write the webhook JSON yourself — use PickMyTrade's own
// alert JSON generator in their dashboard and paste that into the
// TradingView alert message box. See README for the full setup steps.

strategy("Jarvis ORB + VWAP + ADX Scaler - MNQ/MES",
     overlay = true,
     default_qty_type = strategy.fixed,
     default_qty_value = 3,
     pyramiding = 10,
     calc_on_every_tick = false,
     process_orders_on_close = true)

// ---------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------
orMinutes      = input.int(15, "Opening Range Minutes", minval = 1)

sessionStartHour = input.int(9, "Session Start Hour (ET)")
sessionStartMin  = input.int(30, "Session Start Minute (ET)")
sessionEndHour   = input.int(16, "Session End Hour (ET)")
sessionEndMin    = input.int(0, "Session End Minute (ET)")

atrLen  = input.int(14, "ATR Length")
volLen  = input.int(20, "Volume Avg Length")
volMult = input.float(1.5, "Volume Multiplier")

baseSize = input.int(3, "Base Size (contracts)")
addSize  = input.int(3, "Scale-In Add Size")
maxSize  = input.int(9, "Max Position Size (contracts)")

stopAtrMult    = input.float(1.5, "Stop ATR Multiple")
scaleInAtrMult = input.float(1.0, "Scale-In ATR Multiple")
target1AtrMult = input.float(1.0, "Target 1 ATR Multiple")
target2AtrMult = input.float(2.0, "Target 2 ATR Multiple")

dailyKillUSD = input.float(900, "Daily Kill Switch ($) - placeholder, confirm real Tradeify drawdown figure")

useVwapFilter = input.bool(true, "Use VWAP Filter")
useAdxFilter  = input.bool(true, "Use ADX Filter")
adxLen        = input.int(14, "ADX Length")
adxThreshold  = input.float(20, "ADX Threshold")

// ---------------------------------------------------------------------
// Session / time-of-day helpers (ET), used for both the OR window and
// the overall trading session — plain minute-of-day arithmetic, no
// session-string parsing needed.
// ---------------------------------------------------------------------
etHour   = hour(time, "America/New_York")
etMinute = minute(time, "America/New_York")
etDay    = dayofmonth(time, "America/New_York")

nowMinutes           = etHour * 60 + etMinute
sessionStartMinutes  = sessionStartHour * 60 + sessionStartMin
sessionEndMinutes    = sessionEndHour * 60 + sessionEndMin
minutesSinceOpen     = nowMinutes - sessionStartMinutes

withinOR  = minutesSinceOpen >= 0 and minutesSinceOpen < orMinutes
afterOR   = minutesSinceOpen >= orMinutes
inSession = nowMinutes >= sessionStartMinutes and nowMinutes <= sessionEndMinutes

// ---------------------------------------------------------------------
// Opening Range tracking (resets each new ET calendar day)
// ---------------------------------------------------------------------
newDay = ta.change(etDay) != 0

var float orHigh = na
var float orLow = na

if newDay
    orHigh := na
    orLow := na

if withinOR
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow := na(orLow) ? low : math.min(orLow, low)

orReady = not na(orHigh) and not na(orLow) and afterOR

// Visual "tool": OR high/low plotted as step-lines, plus a shaded
// background during OR formation, so the range is visible on the chart.
plot(orReady or withinOR ? orHigh : na, "OR High", color = color.lime, style = plot.style_stepline, linewidth = 2)
plot(orReady or withinOR ? orLow : na, "OR Low", color = color.red, style = plot.style_stepline, linewidth = 2)
bgcolor(withinOR ? color.new(color.blue, 90) : na, title = "Opening Range Window")

// ---------------------------------------------------------------------
// Indicators
// ---------------------------------------------------------------------
atrVal  = ta.atr(atrLen)
avgVol  = ta.sma(volume, volLen)
volConfirmed = volume > (avgVol * volMult)

vwapValue = ta.vwap(hlc3)
[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)

plot(useVwapFilter ? vwapValue : na, "VWAP", color = color.yellow, linewidth = 2)

// ---------------------------------------------------------------------
// Daily kill switch
// ---------------------------------------------------------------------
var float dayStartEquity = na
var bool  dailyHalted = false

if newDay
    dayStartEquity := strategy.equity
    dailyHalted := false

dailyPnl = na(dayStartEquity) ? 0.0 : strategy.equity - dayStartEquity

if dailyPnl <= -dailyKillUSD and not dailyHalted
    strategy.close_all(comment = "DAILY KILL SWITCH")
    dailyHalted := true

canTrade = inSession and afterOR and not dailyHalted

// ---------------------------------------------------------------------
// Entry signal: Opening Range Breakout + VWAP + Volume + ADX
// ---------------------------------------------------------------------
breakoutUp   = orReady and close > orHigh
breakoutDown = orReady and close < orLow

if useVwapFilter
    breakoutUp := breakoutUp and close > vwapValue
    breakoutDown := breakoutDown and close < vwapValue

if useAdxFilter
    breakoutUp := breakoutUp and adxValue >= adxThreshold
    breakoutDown := breakoutDown and adxValue >= adxThreshold

crossUp   = breakoutUp and volConfirmed
crossDown = breakoutDown and volConfirmed

// ---------------------------------------------------------------------
// Per-position state (reset whenever flat)
// ---------------------------------------------------------------------
var float lastScalePrice = na
var float stopPrice = na
var bool  target1Hit = false
var bool  target2Hit = false

if strategy.position_size == 0
    lastScalePrice := na
    stopPrice := na
    target1Hit := false
    target2Hit := false

if strategy.position_size != 0 and na(lastScalePrice)
    lastScalePrice := strategy.position_avg_price
    stopPrice := strategy.position_size > 0 ?
         close - atrVal * stopAtrMult : close + atrVal * stopAtrMult

// ---------------------------------------------------------------------
// Entries
// ---------------------------------------------------------------------
if canTrade and crossUp and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty = baseSize, comment = "ORB LONG")

if canTrade and crossDown and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty = baseSize, comment = "ORB SHORT")

// ---------------------------------------------------------------------
// Scale in — only on continued confirmed momentum, never into a loser
// ---------------------------------------------------------------------
longFavorable  = strategy.position_size > 0 ? close - lastScalePrice : na
shortFavorable = strategy.position_size < 0 ? lastScalePrice - close : na

canScaleInLong  = canTrade and strategy.position_size > 0 and strategy.position_size < maxSize and
     not na(longFavorable) and longFavorable >= atrVal * scaleInAtrMult and volConfirmed
canScaleInShort = canTrade and strategy.position_size < 0 and math.abs(strategy.position_size) < maxSize and
     not na(shortFavorable) and shortFavorable >= atrVal * scaleInAtrMult and volConfirmed

if canScaleInLong
    strategy.entry("Long", strategy.long, qty = addSize, comment = "SCALE IN")
    lastScalePrice := close
    stopPrice := close - atrVal

if canScaleInShort
    strategy.entry("Short", strategy.short, qty = addSize, comment = "SCALE IN")
    lastScalePrice := close
    stopPrice := close + atrVal

// ---------------------------------------------------------------------
// Stop loss (always active, regardless of session, for safety)
// ---------------------------------------------------------------------
if strategy.position_size > 0 and close <= stopPrice
    strategy.close("Long", comment = "STOP")

if strategy.position_size < 0 and close >= stopPrice
    strategy.close("Short", comment = "STOP")

// ---------------------------------------------------------------------
// Partial profit taking (always active, regardless of session)
// ---------------------------------------------------------------------
target1Long  = lastScalePrice + atrVal * target1AtrMult
target2Long  = lastScalePrice + atrVal * target2AtrMult
target1Short = lastScalePrice - atrVal * target1AtrMult
target2Short = lastScalePrice - atrVal * target2AtrMult

if strategy.position_size > 0 and not target2Hit and close >= target2Long
    strategy.close("Long", qty_percent = 33, comment = "SCALE OUT T2")
    target2Hit := true
    stopPrice := lastScalePrice
else if strategy.position_size > 0 and not target1Hit and close >= target1Long
    strategy.close("Long", qty_percent = 33, comment = "SCALE OUT T1")
    target1Hit := true

if strategy.position_size < 0 and not target2Hit and close <= target2Short
    strategy.close("Short", qty_percent = 33, comment = "SCALE OUT T2")
    target2Hit := true
    stopPrice := lastScalePrice
else if strategy.position_size < 0 and not target1Hit and close <= target1Short
    strategy.close("Short", qty_percent = 33, comment = "SCALE OUT T1")
    target1Hit := true

// ---------------------------------------------------------------------
// On-chart status table
// ---------------------------------------------------------------------
var table statusTable = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    table.cell(statusTable, 0, 0, "Daily P&L", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 0, str.tostring(dailyPnl, "#.##"), bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 1, "Kill Switch", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 1, dailyHalted ? "HALTED" : "Active",
         bgcolor = color.gray, text_color = dailyHalted ? color.red : color.green)
    table.cell(statusTable, 0, 2, "Position", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 2, str.tostring(strategy.position_size), bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 3, "In Session", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 3, inSession ? "Yes" : "No", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 4, "OR High / Low", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 4, (na(orHigh) or na(orLow)) ? "—" : str.tostring(orHigh, "#.##") + " / " + str.tostring(orLow, "#.##"),
         bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 5, "ADX", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 5, na(adxValue) ? "—" : str.tostring(adxValue, "#.##"), bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 6, "Stop Price", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 6, na(stopPrice) ? "—" : str.tostring(stopPrice, "#.##"),
         bgcolor = color.gray, text_color = color.white)
