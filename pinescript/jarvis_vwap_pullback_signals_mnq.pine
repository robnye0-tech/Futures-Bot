// @version=6
// Jarvis VWAP Pullback Trend-Continuation — SIGNAL-ONLY — MNQ
//
// Manual-trading version of jarvis_vwap_pullback_mnq.pine: same entry
// logic (a rejection-candle pullback to VWAP during a moderately
// trending regime, confirmed by a breakout of that candle's high/low),
// but plots buy/sell markers and fires alerts instead of auto-managing
// a simulated position. No strategy() declaration, no position sizing,
// no scale-in, no automatic exits, no PickMyTrade wiring needed - you
// see the signal, you decide whether and how to trade it, and you
// manage your own stop/target/risk from there.
//
// Reference stop/target levels ARE shown on each signal (same ATR
// multiples the backtested version uses) so you have a concrete number
// to work from, but nothing closes or manages a position automatically -
// there's no simulated broker connection, so this script has no idea
// whether you're currently in a trade. That's on you to track.
//
// Same validation status as the strategy version: real TradingView
// result on MNQ 5m was PF 1.527 / 52 trades / $4,928 net, but with a
// $3,570 max drawdown against the account's $2,000 limit at 3/3/9
// contract sizing - the sizing fix (reduced size, NOT a tighter stop -
// tighter stops were tested and broke the edge) is what a strategy
// version would need before auto-trading. For manual trading, YOU are
// the position-size decision, every time, based on your own risk
// tolerance - there's no dailyKillUSD or account-equity kill switch
// here, because there's no simulated account. Also not yet checked for
// the same "Outliers PnL" concentration problem that showed up on the
// mean-reversion script (real profit dominated by a handful of oversized
// trades, sub-50% win rate) - worth checking on this one too before
// trusting the signals blindly.
//
// Auto-timeframe switching (input "Auto-Adjust Parameters By Chart
// Timeframe", default on) works the same as the strategy version: ADX
// band / trend EMA lengths / stop multiple switch based on the chart's
// timeframe, and signals are DISABLED (no markers, no alerts) on any
// timeframe without a real confirmed edge - currently just 5-minute.
// The "Timeframe" status row shows which state you're in.
//
// To get alerts: right-click the chart -> Add Alert -> Condition ->
// this indicator -> pick "VWAP Pullback Long" or "VWAP Pullback Short".
// Set it to "Once Per Bar Close" so it doesn't fire on an unconfirmed
// intrabar tick.

indicator("Jarvis VWAP Pullback Signals - MNQ", overlay = true)

// ---------------------------------------------------------------------
// Inputs — defaults match the walk-forward-tested 5-minute config
// ---------------------------------------------------------------------
adxLen  = input.int(14, "ADX Length")
adxLow  = input.float(15, "ADX Low Bound (trending regime floor)")
adxHigh = input.float(30, "ADX High Bound (trending regime ceiling)")

trendFastLen = input.int(10, "Trend Fast EMA Length")
trendSlowLen = input.int(50, "Trend Slow EMA Length")

breakoutWindow = input.int(5, "Breakout Window (bars to wait after rejection candle)")

atrLen  = input.int(14, "ATR Length")
volLen  = input.int(20, "Volume Avg Length")
volMult = input.float(1.5, "Volume Multiplier")

stopAtrMult    = input.float(1.5, "Stop ATR Multiple (reference only, beyond entry)")
target1AtrMult = input.float(1.0, "Target 1 ATR Multiple (reference only)")
target2AtrMult = input.float(2.0, "Target 2 ATR Multiple (reference only)")

sessionStartHour = input.int(9, "Session Start Hour (ET)")
sessionStartMin  = input.int(30, "Session Start Minute (ET)")
sessionEndHour   = input.int(16, "Session End Hour (ET)")
sessionEndMin    = input.int(0, "Session End Minute (ET)")

autoAdjustByTimeframe = input.bool(true, "Auto-Adjust Parameters By Chart Timeframe",
     tooltip = "When on, ADX band / trend EMA lengths / stop multiple switch automatically based on the chart's timeframe using the configs found in walk-forward + TradingView testing. Timeframes without a real confirmed edge (currently: everything except 5-minute) have signals DISABLED even in auto mode - see the 'Timeframe' status row. Turn this off to force the manual inputs above on any timeframe.")

// ---------------------------------------------------------------------
// Session helpers (ET) - plain minute-of-day arithmetic
// ---------------------------------------------------------------------
etHour   = hour(time, "America/New_York")
etMinute = minute(time, "America/New_York")

nowMinutes          = etHour * 60 + etMinute
sessionStartMinutes = sessionStartHour * 60 + sessionStartMin
sessionEndMinutes   = sessionEndHour * 60 + sessionEndMin
inSession = nowMinutes >= sessionStartMinutes and nowMinutes <= sessionEndMinutes

// ---------------------------------------------------------------------
// Indicators
// ---------------------------------------------------------------------
atrVal = ta.atr(atrLen)
avgVol = ta.sma(volume, volLen)
volConfirmed = volume > (avgVol * volMult)

vwapValue = ta.vwap(hlc3)
[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)

// Per-timeframe config switching - see jarvis_vwap_pullback_mnq.pine for
// why this precomputes every candidate EMA length and only SELECTS among
// them (ta.ema needs a fixed, non-series length).
ema10  = ta.ema(close, 10)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
emaFastManual = ta.ema(close, trendFastLen)
emaSlowManual = ta.ema(close, trendSlowLen)

float effAdxLow  = adxLow
float effAdxHigh = adxHigh
float effStopAtrMult = stopAtrMult
float trendFastEma = emaFastManual
float trendSlowEma = emaSlowManual
bool  tfValidated = true
string tfLabel = "Manual"

if autoAdjustByTimeframe
    if timeframe.period == "5"
        effAdxLow := 15.0
        effAdxHigh := 30.0
        effStopAtrMult := 1.5
        trendFastEma := ema10
        trendSlowEma := ema50
        tfValidated := true
        tfLabel := "5m (validated)"
    else if timeframe.period == "15"
        effAdxLow := 20.0
        effAdxHigh := 40.0
        effStopAtrMult := 2.0
        trendFastEma := ema10
        trendSlowEma := ema100
        tfValidated := false
        tfLabel := "15m (NOT validated - PF ~1.05 on real data)"
    else
        tfValidated := false
        tfLabel := timeframe.period + " (untested)"

regimeTrending = adxValue >= effAdxLow and adxValue <= effAdxHigh
uptrend   = trendFastEma > trendSlowEma
downtrend = trendFastEma < trendSlowEma

canSignal = inSession and tfValidated

plot(vwapValue, "VWAP", color = color.yellow, linewidth = 2)
plot(trendFastEma, "Trend Fast EMA", color = color.aqua)
plot(trendSlowEma, "Trend Slow EMA", color = color.purple)

// ---------------------------------------------------------------------
// Pending setup tracking: a rejection candle sets a pending breakout
// level, a later bar breaking it fires the actual signal. No position
// concept here - this just tracks "waiting on a setup" vs. "not."
// ---------------------------------------------------------------------
var string pendingDirection = na
var float  pendingTrigger = na
var int    pendingBarsLeft = 0

longSignal = false
shortSignal = false
var float lastLongStop = na
var float lastLongT1 = na
var float lastLongT2 = na
var float lastShortStop = na
var float lastShortT1 = na
var float lastShortT2 = na

if canSignal
    if pendingDirection == "long"
        if high >= pendingTrigger
            longSignal := true
            lastLongStop := close - atrVal * effStopAtrMult
            lastLongT1 := close + atrVal * target1AtrMult
            lastLongT2 := close + atrVal * target2AtrMult
            pendingDirection := na
        else
            pendingBarsLeft := pendingBarsLeft - 1
            if pendingBarsLeft <= 0
                pendingDirection := na
    else if pendingDirection == "short"
        if low <= pendingTrigger
            shortSignal := true
            lastShortStop := close + atrVal * effStopAtrMult
            lastShortT1 := close - atrVal * target1AtrMult
            lastShortT2 := close - atrVal * target2AtrMult
            pendingDirection := na
        else
            pendingBarsLeft := pendingBarsLeft - 1
            if pendingBarsLeft <= 0
                pendingDirection := na

    if na(pendingDirection)
        // Rejection candle: dipped to/through VWAP then closed back on the trend side
        if uptrend and regimeTrending and low <= vwapValue and close > vwapValue and close > open and volConfirmed
            pendingDirection := "long"
            pendingTrigger := high
            pendingBarsLeft := breakoutWindow
        else if downtrend and regimeTrending and high >= vwapValue and close < vwapValue and close < open and volConfirmed
            pendingDirection := "short"
            pendingTrigger := low
            pendingBarsLeft := breakoutWindow

// ---------------------------------------------------------------------
// Markers, reference levels, and alerts
// ---------------------------------------------------------------------
plotshape(longSignal, "Long Signal", style = shape.triangleup, location = location.belowbar,
     color = color.lime, size = size.small, text = "LONG")
plotshape(shortSignal, "Short Signal", style = shape.triangledown, location = location.abovebar,
     color = color.red, size = size.small, text = "SHORT")

if longSignal
    label.new(bar_index, low, "LONG\nStop: " + str.tostring(lastLongStop, "#.##") +
         "\nT1: " + str.tostring(lastLongT1, "#.##") + "\nT2: " + str.tostring(lastLongT2, "#.##"),
         style = label.style_label_up, color = color.new(color.lime, 20), textcolor = color.black,
         yloc = yloc.belowbar)

if shortSignal
    label.new(bar_index, high, "SHORT\nStop: " + str.tostring(lastShortStop, "#.##") +
         "\nT1: " + str.tostring(lastShortT1, "#.##") + "\nT2: " + str.tostring(lastShortT2, "#.##"),
         style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white,
         yloc = yloc.abovebar)

alertcondition(longSignal, title = "VWAP Pullback Long", message = "Jarvis VWAP Pullback LONG signal on {{ticker}} at {{close}}")
alertcondition(shortSignal, title = "VWAP Pullback Short", message = "Jarvis VWAP Pullback SHORT signal on {{ticker}} at {{close}}")

// ---------------------------------------------------------------------
// On-chart status table
// ---------------------------------------------------------------------
var table statusTable = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(statusTable, 0, 0, "Timeframe", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 0, tfLabel, bgcolor = color.gray, text_color = tfValidated ? color.green : color.orange)
    table.cell(statusTable, 0, 1, "In Session", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 1, inSession ? "Yes" : "No", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 2, "ADX (regime)", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 2, str.tostring(adxValue, "#.##") + (regimeTrending ? " (In band)" : " (Out)"),
         bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 0, 3, "Trend / Pending", bgcolor = color.gray, text_color = color.white)
    table.cell(statusTable, 1, 3, (uptrend ? "Up" : downtrend ? "Down" : "Flat") + " / " +
         (na(pendingDirection) ? "-" : pendingDirection),
         bgcolor = color.gray, text_color = color.white)
