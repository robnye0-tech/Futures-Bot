# Copy this file to .env and fill in your real values. Never commit .env.

# --- Tradovate (via Tradeify funded account) ---
# Requested through Tradovate's API access program / your prop firm.
TRADING_BROKER=tradovate
TRADOVATE_USERNAME=
TRADOVATE_DEDICATED_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_IS_PAPER=true
# Optional - only set these if Tradovate assigned specific values when
# approving your API access (check your approval email/dashboard).
# TRADOVATE_APP_ID=Jarvis Futures Bot
# TRADOVATE_APP_VERSION=1.0

# --- Alpha Vantage (news feed) ---
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Dashboard ---
DASHBOARD_PORT=5000
