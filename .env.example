# Copy this file to .env and fill in your real values. Never commit .env.

# --- Tradovate (via Tradeify funded account) ---
# Requested through Tradovate's API access program / your prop firm.
TRADING_BROKER=tradovate
TRADOVATE_USERNAME=
TRADOVATE_DEDICATED_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_IS_PAPER=true

# --- Alpha Vantage (news feed) ---
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Dashboard ---
DASHBOARD_PORT=5000
